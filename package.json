{
  "name": "@wsehl/pls",
  "version": "0.1.0",
  "description": "See what's listening on your ports",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsehl/pls.git"
  },
  "bin": {
    "pls": "./dist/pls.mjs"
  },
  "files": [
    "dist/pls.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node src/main.ts",
    "build": "tsdown",
    "start": "node dist/pls.mjs",
    "format": "oxfmt --write .",
    "format-check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "check": "pnpm run type-check && pnpm run lint && pnpm run format-check && pnpm test",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run type-check && pnpm test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/node": "^26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.1"
}
